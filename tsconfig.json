{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["app.ts", "collectors/**/*.ts", "storage/**/*.ts", "server/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "data"]
}
